{
    // ── CSS Validator ─────────────────────────────────────────────────────────
    // Tailwind CSS v4 uses custom at-rules (@source, @theme, @import 'tailwindcss')
    // that VS Code's built-in CSS language server does not recognize.
    // These are NOT errors — they compile correctly via Vite + @tailwindcss/vite.
    "css.lint.unknownAtRules": "ignore",
    "scss.lint.unknownAtRules": "ignore",

    // ── Tailwind IntelliSense ─────────────────────────────────────────────────
    // If you have the Tailwind CSS IntelliSense extension installed,
    // this enables class completions inside Blade files.
    "tailwindCSS.includeLanguages": {
        "blade": "html"
    },
    "tailwindCSS.experimental.classRegex": [
        ["class=\"([^\"]*)", "([^\\s\"]+)"]
    ],

    // ── File Associations ─────────────────────────────────────────────────────
    "files.associations": {
        "*.blade.php": "blade"
    },

    // ── Editor ───────────────────────────────────────────────────────────────
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null,
    "[php]": {
        "editor.defaultFormatter": null
    }
}
